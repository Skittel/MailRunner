# MailRunner node - Postfix main.cf (receive role). Generated by install.sh from
# install/templates/receive/postfix-main.cf. Changes here are overwritten on the next install.

compatibility_level = 3.10
myhostname = {{HOSTNAME}}
myorigin = $myhostname
mydestination =
mynetworks = 127.0.0.0/8 [::1]/128
inet_interfaces = all
inet_protocols = all
biff = no
append_dot_mydomain = no
smtpd_banner = $myhostname ESMTP
disable_vrfy_command = yes
recipient_delimiter =
message_size_limit = 52428800
notify_classes = resource, software

# No local delivery, no outbound mail: a receive node never sends (no bounces, no relay).
local_recipient_maps =
local_transport = error:local delivery is disabled
default_transport = error:outbound mail is disabled on this node
relay_transport = error:outbound mail is disabled on this node
relay_domains =

# Recipients: generated from the database by "spark mr:apply"
virtual_mailbox_domains = texthash:/etc/mailrunner/generated/current/domains
virtual_mailbox_maps = texthash:/etc/mailrunner/generated/current/mailboxes
virtual_transport = mrdeliver:
mrdeliver_destination_recipient_limit = 1

smtpd_helo_required = yes
smtpd_relay_restrictions = permit_mynetworks, reject_unauth_destination
smtpd_recipient_restrictions =
    reject_non_fqdn_recipient,
    check_recipient_access pcre:/etc/mailrunner/generated/current/recipient_access.pcre,
    permit
smtpd_data_restrictions = reject_unauth_pipelining

# TLS for incoming connections (offered, not required). The Received header records
# protocol and cipher; the analysis reads them from there.
smtpd_tls_cert_file = /etc/letsencrypt/live/{{HOSTNAME}}/fullchain.pem
smtpd_tls_key_file = /etc/letsencrypt/live/{{HOSTNAME}}/privkey.pem
smtpd_tls_security_level = may
smtpd_tls_received_header = yes
smtpd_tls_loglevel = 1
smtpd_tls_session_cache_database = btree:${data_directory}/smtpd_scache
