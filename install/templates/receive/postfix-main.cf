# MailRunner node - Postfix main.cf (receive role). Generated by install.sh from
# install/templates/receive/postfix-main.cf. Changes here are overwritten on the next install.

compatibility_level = 3.10
myhostname = {{HOSTNAME}}
myorigin = $myhostname
mydestination =
mynetworks = 127.0.0.0/8 [::1]/128
inet_interfaces = all
inet_protocols = all
biff = no
append_dot_mydomain = no
smtpd_banner = $myhostname ESMTP
disable_vrfy_command = yes
recipient_delimiter =
message_size_limit = 52428800
notify_classes = resource, software

# No local delivery, no outbound mail: a receive node never sends (no bounces, no relay).
local_recipient_maps =
local_transport = error:local delivery is disabled
default_transport = error:outbound mail is disabled on this node
relay_transport = error:outbound mail is disabled on this node
relay_domains =

# Recipients: generated from the database by "spark mr:apply"
virtual_mailbox_domains = texthash:/etc/mailrunner/generated/current/domains
virtual_mailbox_maps = texthash:/etc/mailrunner/generated/current/mailboxes
# Messages are stored by mr-milter before the 250; the milter answers DISCARD, so nothing is
# delivered from the Postfix queue. "discard" is only a safety net (never bounce).
virtual_transport = discard:

# mr-milter decides during the session (decision E-11): store, analyse, then 250 / 451.
# Time limit per message 90 s (milter); Postfix waits a bit longer. No milter = 451, never unchecked.
smtpd_milters = inet:127.0.0.1:8899
non_smtpd_milters =
milter_protocol = 6
milter_default_action = tempfail
milter_connect_timeout = 10s
milter_command_timeout = 70s
milter_content_timeout = 120s
# {daemon_name} tells mr-milter the port: smtp (25) here, submission (587) / smtps (465) in master.cf
milter_macro_daemon_name = smtp

# SMTP AUTH (customer SMTP credentials): mr-auth checks the login (Dovecot auth protocol). An authenticated
# client may name any recipient: mr-milter stores the mail in the credential's project and answers DISCARD,
# so nothing is relayed. Port 25 offers AUTH only after STARTTLS, unless a credential allows plain text
# (smtpd_tls_auth_only is set by "spark mr:apply" from the generated postfix.conf).
smtpd_sasl_auth_enable = yes
smtpd_sasl_type = dovecot
smtpd_sasl_path = inet:127.0.0.1:8897
smtpd_sasl_security_options = noanonymous
smtpd_sasl_tls_security_options = noanonymous
smtpd_sasl_authenticated_header = no
smtpd_tls_auth_only = yes
# unknown recipients are rejected by the explicit reject_unlisted_recipient below (after permit_sasl_authenticated)
smtpd_reject_unlisted_recipient = no

smtpd_helo_required = yes
smtpd_relay_restrictions = permit_mynetworks, permit_sasl_authenticated, reject_unauth_destination
# authenticated: any sender and recipient (the mail is only stored, never relayed)
smtpd_recipient_restrictions =
    permit_sasl_authenticated,
    reject_non_fqdn_recipient,
    reject_unlisted_recipient,
    check_recipient_access pcre:/etc/mailrunner/generated/current/recipient_access.pcre,
    permit
smtpd_data_restrictions = permit_sasl_authenticated, reject_unauth_pipelining

# TLS for incoming connections (offered, not required). The Received header records
# protocol and cipher; the analysis reads them from there.
smtpd_tls_cert_file = /etc/letsencrypt/live/{{HOSTNAME}}/fullchain.pem
smtpd_tls_key_file = /etc/letsencrypt/live/{{HOSTNAME}}/privkey.pem
smtpd_tls_security_level = may
smtpd_tls_received_header = yes
smtpd_tls_loglevel = 1
# Client port in every smtpd log line: mr-smtplog joins Postfix and milter lines of one session by ip:port.
smtpd_client_port_logging = yes
smtpd_tls_session_cache_database = btree:${data_directory}/smtpd_scache
