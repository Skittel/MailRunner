[Unit]
Description=MailRunner: milter (receive: store, analyse, decide before 250; send: hand submissions to the queue)
After=network-online.target unbound.service
Wants=network-online.target
Before=postfix.service

[Service]
Type=simple
User=mailrunner
Group=mailrunner
ExecStart=/opt/mailrunner/current/mailpath/receive/bin/mr-milter
Restart=always
RestartSec=2
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
# send role: submissions are queued by "spark mr:send:accept" (send/store, writable for logs and cache)
ReadWritePaths=/var/lib/mailrunner/receive /var/lib/mailrunner/send /var/lib/mailrunner/writable

[Install]
WantedBy=multi-user.target
