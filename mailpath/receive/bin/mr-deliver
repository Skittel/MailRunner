#!/usr/bin/python3 -I
"""mr-deliver - Postfix pipe(8) transport of the receive role.

Only stores: maps the recipient to its project and writes the encrypted mail plus SMTP data
into spool/new/. No DNS, no database, so receiving never waits for slow checks.
Postfix gets exit 0 only after the entry is on disk (fsync); any internal error returns 75
(EX_TEMPFAIL) and Postfix retries later.

master.cf: mrdeliver unix - n n - 10 pipe user=mailrunner
  argv=.../mr-deliver --queue-id=${queue_id} --client=${client_address} --helo=${client_helo}
       --sender=${sender} --recipient=${original_recipient} --final-recipient=${recipient}
"""
import hashlib
import os
import sys
import syslog
import time

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), ".."))

from mailrunner_rx import config, crypto, spool  # noqa: E402
from mailrunner_rx.routes import Routes  # noqa: E402

EX_TEMPFAIL = 75


def parse_args(argv):
    args = {}
    for arg in argv:
        if arg.startswith("--") and "=" in arg:
            name, value = arg[2:].split("=", 1)
            args[name] = value
    return args


def main():
    args = parse_args(sys.argv[1:])
    raw = sys.stdin.buffer.read()
    recipient = args.get("recipient") or args.get("final-recipient", "")
    client = args.get("client", "")
    if client.lower().startswith("ipv6:"):
        client = client[5:]

    routes = Routes.load(config.ROUTES_FILE)
    route = routes.lookup(recipient) or routes.lookup(args.get("final-recipient", ""))
    if route is None:
        syslog.syslog(syslog.LOG_WARNING, f"no route for recipient queue_id={args.get('queue-id', '')}; tempfail")
        return EX_TEMPFAIL

    spool_id = spool.new_spool_id()
    meta = {
        "spool_id": spool_id,
        "received_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
        "queue_id": args.get("queue-id", ""),
        "client_ip": client,
        "helo": args.get("helo", ""),
        "mail_from": args.get("sender", ""),
        "rcpt": recipient,
        "final_rcpt": args.get("final-recipient", ""),
        "project_id": route["project_id"],
        "project": route["project"],
        "profile": route["profile"],
        "size": len(raw),
        "sha256": hashlib.sha256(raw).hexdigest(),
    }
    spool.write_entry(config.SPOOL_DIR, "new", spool_id, crypto.load_key(config.NODE_KEY_FILE), meta, raw)
    syslog.syslog(syslog.LOG_INFO, f"stored spool_id={spool_id} queue_id={meta['queue_id']} project={route['project']} size={len(raw)}")
    return 0


if __name__ == "__main__":
    if os.environ.get("MR_NO_SYSLOG"):  # tests
        syslog.syslog = lambda *args: None
    syslog.openlog("mailrunner-deliver", syslog.LOG_PID, syslog.LOG_MAIL)
    try:
        sys.exit(main())
    except Exception as e:  # never bounce: let Postfix retry
        syslog.syslog(syslog.LOG_ERR, f"tempfail: {e.__class__.__name__}: {e}")
        sys.exit(EX_TEMPFAIL)
