#!/usr/bin/python3 -I
"""mr-smtplog - receive role: journal of delivery attempts.

Follows the mail log in journald (Postfix smtpd/cleanup + mailrunner-milter session lines), builds one
record per SMTP session (mailrunner_rx.smtplog) and hands finished sessions to `spark mr:import`
as encrypted files spool/smtp/<session_id>.json. The importer assigns them to projects (routes)
and writes journal events smtp.connection / smtp.attempt.

Restart-safe: the journal cursor before the oldest open session is kept in
/var/lib/mailrunner/receive/smtplog.state; re-delivered sessions are deduplicated by the importer.

Runs as systemd service mailrunner-smtplog (user mailrunner, supplementary group systemd-journal).
"""
import json
import os
import select
import subprocess
import sys
import syslog
import time

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), ".."))

from mailrunner_rx import config, crypto, store  # noqa: E402
from mailrunner_rx.smtplog import Tracker  # noqa: E402

STATE_FILE = os.path.join(config.DATA_DIR, "receive", "smtplog.state")
OUT_DIR = os.path.join(config.SPOOL_DIR, "smtp")
FIRST_START_SINCE = os.environ.get("MR_SMTPLOG_SINCE", "-24h")
STATE_EVERY_SECONDS = 5


def wanted(ident):
    return ident == "mailrunner-milter" or (ident.startswith("postfix") and (ident.endswith("/smtpd") or ident.endswith("/cleanup")))


def load_state():
    try:
        with open(STATE_FILE) as f:
            return json.load(f).get("cursor")
    except (FileNotFoundError, ValueError):
        return None


def save_state(cursor):
    if cursor:
        store.write_atomic(STATE_FILE, json.dumps({"cursor": cursor}).encode())


def emit(key, session):
    path = os.path.join(OUT_DIR, f"{session['session_id']}.json")
    data = crypto.encrypt(key, json.dumps(session, ensure_ascii=False).encode(), f"spool:{session['session_id']}:smtp")
    store.write_atomic(path, data)


def main():
    syslog.openlog("mailrunner-smtplog", syslog.LOG_PID, syslog.LOG_MAIL)
    os.makedirs(OUT_DIR, mode=0o750, exist_ok=True)
    key = crypto.load_key(config.NODE_KEY_FILE)
    cursor = load_state()
    cmd = ["journalctl", "--follow", "--output=json", "--no-pager", "SYSLOG_FACILITY=2"]
    cmd += [f"--after-cursor={cursor}"] if cursor else [f"--since={FIRST_START_SINCE}"]
    syslog.syslog(syslog.LOG_INFO, "starting " + ("from saved cursor" if cursor else f"since {FIRST_START_SINCE}"))
    # unbuffered: select() must see every line that journalctl wrote (no lines hidden in a Python buffer)
    proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, bufsize=0)
    fd = proc.stdout.fileno()
    tracker = Tracker()
    tracker.last_cursor = cursor
    last_state = 0.0
    pending = b""
    while True:
        ready, _, _ = select.select([fd], [], [], 1.0)
        finished = []
        if ready:
            chunk = os.read(fd, 65536)
            if not chunk:
                syslog.syslog(syslog.LOG_ERR, "journalctl ended")
                return 1
            pending += chunk
            *lines, pending = pending.split(b"\n")
            for line in lines:
                finished += handle(tracker, line)
        else:
            # caught up and idle: close sessions by wall clock (while reading, entry time is used)
            finished += tracker.due(time.time())
        for session in finished:
            emit(key, session)
        if time.monotonic() - last_state >= STATE_EVERY_SECONDS or finished:
            save_state(tracker.resume_cursor())
            last_state = time.monotonic()


def handle(tracker, line):
    try:
        e = json.loads(line)
    except ValueError:
        return []
    ident = e.get("SYSLOG_IDENTIFIER") or ""
    cur = e.get("__CURSOR")
    if not (wanted(ident) and isinstance(e.get("MESSAGE"), str)):
        tracker.last_cursor = cur
        return []
    ts = int(e.get("__REALTIME_TIMESTAMP", "0")) / 1e6
    pid = e.get("SYSLOG_PID") or e.get("_PID") or ""
    return tracker.feed(ident, pid, ts, e["MESSAGE"], cur)


if __name__ == "__main__":
    sys.exit(main())
