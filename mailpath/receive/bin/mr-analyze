#!/usr/bin/python3 -I
"""mr-analyze - processes spool/new/ (started by systemd path unit, runs as mailrunner).

Profile "analysis": runs the SmartMailFlow analysis on the node and writes an analysed entry
that holds only the header data and the analysis JSON. Node-wide credentials (Spamhaus DQS,
blacklistmaster) come from /etc/mailrunner/secrets.env. The raw mail is deleted right after
the analysis (decision E-05/E-07). Other profiles are not implemented yet; their entries are
moved to spool/failed/ (kept encrypted, never deleted silently).
"""
import email
import fcntl
import os
import sys
import syslog
from email.utils import parseaddr

BASE = os.path.join(os.path.dirname(os.path.realpath(__file__)), "..")
sys.path.insert(0, BASE)
sys.path.insert(0, os.path.join(BASE, "..", "vendor", "smartmailflow"))

from mailrunner_rx import blacklistmaster, config, secrets, spool  # noqa: E402
from mailrunner_rx.crypto import load_key  # noqa: E402


def raw_header_block(raw):
    for sep in (b"\r\n\r\n", b"\n\n"):
        pos = raw.find(sep)
        if pos != -1:
            return raw[:pos].decode("utf-8", errors="replace")
    return raw.decode("utf-8", errors="replace")


def localpart(addr):
    return addr.split("@")[0] if "@" in addr else ""


def analyze_entry(raw, meta, creds):
    from smartmailflow.analysis import analyze
    from smartmailflow.dnsclient import DNSClient

    envelope = {"client_ip": meta["client_ip"] or "0.0.0.0", "helo": meta["helo"] or "unknown",
                "mail_from": meta["mail_from"], "rcpt": meta["rcpt"]}
    result = analyze(raw, envelope, DNSClient(), {"spamhaus_dqs_key": creds.get("SPAMHAUS_DQS_KEY")})
    msg = email.message_from_bytes(raw)
    # same rule as SmartMailFlow's receive pipe
    mail_id = (localpart(meta["rcpt"]) or localpart(parseaddr(msg.get("To", ""))[1])
               or (msg.get("Message-ID") or "").strip("<>"))
    if creds.get("BLM_USER") and creds.get("BLM_PASS"):
        result["debug"]["blacklistmaster"] = blacklistmaster.check(envelope["client_ip"], mail_id, creds["BLM_USER"], creds["BLM_PASS"])
    return {**result, "mail_id": mail_id, "raw_headers": raw_header_block(raw)}


def process(spool_id, key, creds):
    meta = spool.read_meta(config.SPOOL_DIR, "new", spool_id, key)
    if meta["profile"] != "analysis":
        spool.move_to_failed(config.SPOOL_DIR, "new", spool_id, f"profile {meta['profile']} not implemented yet")
        syslog.syslog(syslog.LOG_WARNING, f"spool_id={spool_id} profile={meta['profile']} not implemented, moved to failed")
        return
    raw = spool.read_raw(config.SPOOL_DIR, "new", spool_id, key)
    meta["analysis"] = analyze_entry(raw, meta, creds)
    meta["raw_deleted"] = True
    spool.write_entry(config.SPOOL_DIR, "analyzed", spool_id, key, meta)   # header data + JSON only
    spool.remove(config.SPOOL_DIR, "new", spool_id)                      # raw mail is gone now
    syslog.syslog(syslog.LOG_INFO, f"analysed spool_id={spool_id} project={meta['project']} "
                                   f"duration_ms={meta['analysis']['debug'].get('duration_ms')}")


def main():
    lock = open(os.path.join(config.SPOOL_DIR, ".analyze.lock"), "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        return 0  # another run is active
    key = load_key(config.NODE_KEY_FILE)
    creds = secrets.load()
    for spool_id in spool.ready_ids(config.SPOOL_DIR, "new"):
        try:
            process(spool_id, key, creds)
        except Exception as e:
            spool.move_to_failed(config.SPOOL_DIR, "new", spool_id, f"{e.__class__.__name__}: {e}")
            syslog.syslog(syslog.LOG_ERR, f"spool_id={spool_id} failed: {e.__class__.__name__}: {e}")
    return 0


if __name__ == "__main__":
    syslog.openlog("mailrunner-analyze", syslog.LOG_PID, syslog.LOG_MAIL)
    sys.exit(main())
